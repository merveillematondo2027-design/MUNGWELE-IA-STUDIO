rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.email == 'merveillematondo2027@gmail.com'); }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.userId == request.auth.uid; }

    function validReferralReward(inviterId) {
      let refPath = /databases/$(database)/documents/referrals/$(request.auth.uid);
      return signedIn() && request.auth.uid != inviterId && exists(refPath) && get(refPath).data.inviterId == inviterId && get(refPath).data.rewardApplied == false && get(refPath).data.bonus == 100 && getAfter(refPath).data.rewardApplied == true && request.resource.data.credits == resource.data.credits + 100 && request.resource.data.referralRewardsCount == resource.data.referralRewardsCount + 1 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits','referralRewardsCount','updatedAt']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.credits == 100 && request.resource.data.welcomeBonusGranted == true && request.resource.data.welcomeBonusVersion == 2 && request.resource.data.referralRewardsCount == 0 && request.resource.data.referralCode is string && ((isAdmin() && request.resource.data.role in ['admin','user']) || (!isAdmin() && request.resource.data.role == 'user'));
      allow update: if isAdmin() || validReferralReward(userId) || (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.welcomeBonusGranted == resource.data.welcomeBonusGranted && request.resource.data.totalGenerations >= resource.data.totalGenerations && (request.resource.data.credits <= resource.data.credits || (resource.data.welcomeBonusGranted == true && (!('welcomeBonusVersion' in resource.data) || resource.data.welcomeBonusVersion < 2) && request.resource.data.welcomeBonusVersion == 2 && request.resource.data.credits == resource.data.credits + 50)));
      allow delete: if isAdmin();
    }

    match /referralCodes/{code} { allow read: if signedIn(); allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid; allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); }
    match /referrals/{referredUserId} { allow read: if isAdmin() || (signedIn() && (request.auth.uid == referredUserId || resource.data.inviterId == request.auth.uid)); allow create: if isOwner(referredUserId) && request.resource.data.userId == request.auth.uid && request.resource.data.referredUserId == request.auth.uid && request.resource.data.inviterId != request.auth.uid && request.resource.data.bonus == 100 && request.resource.data.rewardApplied == false; allow update: if isOwner(referredUserId) && resource.data.rewardApplied == false && request.resource.data.rewardApplied == true && request.resource.data.inviterId == resource.data.inviterId && request.resource.data.bonus == 100 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardApplied','rewardedAt']); allow delete: if isAdmin(); }
    match /appSettings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /creditPacks/{packId} { allow read: if true; allow write: if isAdmin(); }

    match /generations/{generationId} {
      allow read: if ownsExisting() || isAdmin() || (signedIn() && resource.data.isPublic == true);
      allow create: if ownsIncoming() || isAdmin();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if ownsExisting() || isAdmin();

      match /likes/{userId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/generations/$(generationId)).data.isPublic == true;
        allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid && get(/databases/$(database)/documents/generations/$(generationId)).data.isPublic == true;
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/generations/$(generationId)).data.isPublic == true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.text is string && get(/databases/$(database)/documents/generations/$(generationId)).data.isPublic == true;
        allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    match /images/{imageId} { allow read: if ownsExisting() || isAdmin(); allow create: if ownsIncoming() || isAdmin(); allow update: if isAdmin() || (ownsExisting() && ownsIncoming()); allow delete: if ownsExisting() || isAdmin(); }
    match /videos/{videoId} { allow read: if ownsExisting() || isAdmin(); allow create: if ownsIncoming() || isAdmin(); allow update: if isAdmin() || (ownsExisting() && ownsIncoming()); allow delete: if ownsExisting() || isAdmin(); }
    match /musics/{musicId} { allow read: if ownsExisting() || isAdmin(); allow create: if ownsIncoming() || isAdmin(); allow update: if isAdmin() || (ownsExisting() && ownsIncoming()); allow delete: if ownsExisting() || isAdmin(); }
    match /projects/{projectId} { allow read: if ownsExisting() || isAdmin(); allow create: if ownsIncoming(); allow update: if isAdmin() || (ownsExisting() && ownsIncoming()); allow delete: if ownsExisting() || isAdmin(); }
    match /favorites/{favoriteId} { allow read, delete: if ownsExisting() || isAdmin(); allow create: if ownsIncoming(); allow update: if isAdmin() || (ownsExisting() && ownsIncoming()); }
    match /creditTransactions/{transactionId} { allow read: if ownsExisting() || isAdmin(); allow create: if ownsIncoming() || isAdmin(); allow update, delete: if isAdmin(); }

    match /communityPosts/{postId} {
      allow read: if signedIn(); allow create: if ownsIncoming() || isAdmin(); allow update: if isAdmin() || (ownsExisting() && ownsIncoming()); allow delete: if ownsExisting() || isAdmin();
      match /likes/{userId} { allow read: if signedIn(); allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid; allow delete: if isOwner(userId) || isAdmin(); allow update: if false; }
      match /comments/{commentId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.text is string; allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); }
    }

    match /follows/{followId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.followerId == request.auth.uid && request.resource.data.targetId != request.auth.uid; allow delete: if isAdmin() || (signedIn() && resource.data.followerId == request.auth.uid); allow update: if false; }
    match /notifications/{notificationId} { allow read: if ownsExisting() || isAdmin(); allow create: if signedIn() && request.resource.data.actorId == request.auth.uid && request.resource.data.userId != request.auth.uid; allow update, delete: if ownsExisting() || isAdmin(); }
    match /conversations/{conversationId} { allow read: if signedIn() && request.auth.uid in resource.data.members; allow create: if signedIn() && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2; allow update: if signedIn() && request.auth.uid in resource.data.members && request.auth.uid in request.resource.data.members; allow delete: if isAdmin(); match /messages/{messageId} { function parentConversation() { return get(/databases/$(database)/documents/conversations/$(conversationId)); } allow read: if signedIn() && request.auth.uid in parentConversation().data.members; allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.senderId == request.auth.uid && request.resource.data.recipientId in parentConversation().data.members; allow update: if signedIn() && request.auth.uid == resource.data.recipientId; allow delete: if isAdmin(); } }
    match /payments/{paymentId} { allow read: if ownsExisting() || isAdmin(); allow write: if isAdmin(); }
    match /apiProviders/{providerId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
