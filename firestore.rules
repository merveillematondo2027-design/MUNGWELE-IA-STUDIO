rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'merveillematondo2027@gmail.com'
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.credits == 100
        && request.resource.data.welcomeBonusGranted == true
        && request.resource.data.welcomeBonusVersion == 2
        && (
          (isAdmin() && request.resource.data.role in ['admin', 'user']) ||
          (!isAdmin() && request.resource.data.role == 'user')
        );

      // Un utilisateur ne peut jamais augmenter librement son solde.
      // Il peut uniquement consommer ses crédits. La seule hausse autorisée
      // est la migration unique de +50 pour les anciens comptes bonus v1.
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.welcomeBonusGranted == resource.data.welcomeBonusGranted
        && request.resource.data.totalGenerations >= resource.data.totalGenerations
        && (
          request.resource.data.credits <= resource.data.credits
          || (
            resource.data.welcomeBonusGranted == true
            && (!('welcomeBonusVersion' in resource.data) || resource.data.welcomeBonusVersion < 2)
            && request.resource.data.welcomeBonusVersion == 2
            && request.resource.data.credits == resource.data.credits + 50
          )
        )
      );

      allow delete: if isAdmin();
    }

    match /appSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /creditPacks/{packId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /generations/{generationId} {
      allow read: if ownsExisting() || isAdmin() || (signedIn() && resource.data.isPublic == true);
      allow create: if ownsIncoming() || isAdmin();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if ownsExisting() || isAdmin();
    }

    match /images/{imageId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsIncoming() || isAdmin();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if ownsExisting() || isAdmin();
    }

    match /videos/{videoId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsIncoming() || isAdmin();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if ownsExisting() || isAdmin();
    }

    match /musics/{musicId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsIncoming() || isAdmin();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if ownsExisting() || isAdmin();
    }

    match /projects/{projectId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsIncoming();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if ownsExisting() || isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read, delete: if ownsExisting() || isAdmin();
      allow create: if ownsIncoming();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
    }

    match /creditTransactions/{transactionId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsIncoming() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if ownsIncoming() || isAdmin();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if ownsExisting() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if isAdmin();
    }

    match /apiProviders/{providerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
