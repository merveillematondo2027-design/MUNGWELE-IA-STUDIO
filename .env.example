# ============================================================
# MUNGWELE IA STUDIO — PRIVATE SERVER SECRETS ONLY
# Public configuration is already built into the application.
# Never commit real secret values to GitHub.
# ============================================================

# GOOGLE / GEMINI — PRIVATE
GEMINI_API_KEY=

# OPENAI IMAGE — PRIVATE
OPENAI_API_KEY=

# ELEVENLABS MUSIC — PRIVATE
ELEVENLABS_API_KEY=

# RUNWAY — PRIVATE
RUNWAY_API_KEY=

# MARKET-CASH — PRIVATE
MARKET_CASH_API_KEY=

# ============================================================
# VODACOM M-PESA RDC — CURRENT SANDBOX TEST
# ============================================================
# This is the only M-Pesa value required for the current Sandbox verifier.
# The following public values are already embedded safely in the server code:
# openapi.m-pesa.com, vodacomDRC, DRC, USD, Origin *, test MSISDN
# 000000000001, test Service Provider Code 000000, 30-second warmup,
# and the official OpenAPI RSA PUBLIC encryption key.
MPESA_SANDBOX_API_KEY=

# ============================================================
# FIREBASE ADMIN — PRIVATE
# ============================================================
# Recommended for hosted environments that do not expose Application Default
# Credentials with Firestore IAM permissions. Store the complete service-account
# JSON as ONE private secret value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================================
# PRODUCTION VALUES — DO NOT ENTER YET
# ============================================================
# After Vodacom approves MUNGWELE IA for Live M-Pesa, add these deployment
# secrets directly in the production host:
#   MPESA_API_KEY
#   MPESA_SERVICE_PROVIDER_CODE
# Optional only if Vodacom requires an approved origin or a different RSA key:
#   MPESA_ORIGIN
#   MPESA_PUBLIC_KEY
#
# Airtel Money and Orange Money secrets are intentionally not requested yet;
# those providers are only marked as prepared in the interface.
#
# Firebase Web configuration, project ID and storage bucket are public and
# already have the correct defaults in src/config/firebase.ts and server/firebaseAdmin.ts.
