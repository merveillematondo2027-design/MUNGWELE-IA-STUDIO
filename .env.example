# ============================================================
# MUNGWELE IA STUDIO — ENVIRONMENT TEMPLATE
# Never commit private server secrets to GitHub.
# ============================================================

# APP
APP_URL="MY_APP_URL"

# GOOGLE VIDEO + PROMPT ASSISTANT — SERVER ONLY
# Veo 3.1 Lite / Fast / Standard and existing Google compatibility flow.
GEMINI_API_KEY=

# OPENAI IMAGE — SERVER ONLY
# GPT-Image-2 generation and editing.
OPENAI_API_KEY=

# ELEVENLABS MUSIC — SERVER ONLY
ELEVENLABS_API_KEY=
# Backward-compatible alias currently accepted by the server.
MUSIC_PROVIDER_API_KEY=

# RUNWAY DEV — SERVER ONLY
# Selected supplier for Seedance 2 Mini / Fast / Standard / 2.5 and Act-Two clips.
# Store ONE Runway developer API secret; do not expose it to the browser.
RUNWAY_API_KEY=
# Optional alias if the hosting environment already uses Runway's standard name.
RUNWAYML_API_SECRET=

# MARKET-CASH PAYMENTS — SERVER ONLY
# Required: private Developer API key issued by Market-Cash.
# Never expose this key with a VITE_ prefix.
MARKET_CASH_API_KEY=
# Optional override only. Leave empty to use the official Market-Cash
# API-key payment bridge deployed by the Market-Cash project.
MARKET_CASH_API_URL=
# Optional: protects the renewal endpoint when an external scheduler is used.
# Keep this value private. The application also runs an idempotent billing
# worker while the server is online.
MUNGWELE_BILLING_CRON_SECRET=

# ============================================================
# MOBILE MONEY RDC — SERVER ONLY
# Never expose payment-provider secrets with a VITE_ prefix.
# ============================================================

# VODACOM M-PESA OPENAPI — C2B
# Start with sandbox. Change to "production" only after Vodacom activates
# the organisation/short code and production API credentials.
MPESA_MODE=sandbox
MPESA_API_KEY=
# Paste the complete public key supplied/displayed by the M-Pesa OpenAPI portal.
# It may be stored as PEM text or as the base64 key body; the server normalizes it.
MPESA_PUBLIC_KEY=
MPESA_BASE_URL=https://openapi.m-pesa.com
MPESA_MARKET=vodacomRC
MPESA_COUNTRY=RDC
MPESA_CURRENCY=USD
# Sandbox value from the RDC OpenAPI documentation. Replace in production
# with the real M-Pesa Business short code / Service Provider Code.
MPESA_SERVICE_PROVIDER_CODE=000000
# Sandbox can stay *. In production, use the server/domain origin allowed
# in the M-Pesa application configuration.
MPESA_ORIGIN=*
# Session cache duration. Keep below the actual M-Pesa session lifetime.
MPESA_SESSION_TTL_SECONDS=3000
# Optional delay after getSession if the provider needs propagation time.
MPESA_SESSION_WARMUP_MS=0

# AIRTEL MONEY RDC — RESERVED FOR THE NEXT PROVIDER CONNECTION
# Keep empty until Airtel/aggregator production credentials are issued.
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=
AIRTEL_MONEY_API_URL=

# ORANGE MONEY RDC — RESERVED FOR THE NEXT PROVIDER CONNECTION
# Keep empty until Orange/aggregator production credentials are issued.
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_API_URL=

# FIREBASE WEB SDK — PUBLIC CLIENT CONFIG
VITE_FIREBASE_API_KEY="AIzaSyCqY3gtNKX62oFAwdSibtihDA1ifj8SxXs"
VITE_FIREBASE_AUTH_DOMAIN="diablo-design-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="diablo-design-ai"
VITE_FIREBASE_STORAGE_BUCKET="diablo-design-ai.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="582509216306"
VITE_FIREBASE_APP_ID="1:582509216306:web:61337d7a38ff9aa4abf22b"
VITE_FIREBASE_MEASUREMENT_ID="G-77CWBPF23Q"

# FIREBASE ADMIN — SERVER ONLY
FIREBASE_PROJECT_ID="diablo-design-ai"
FIREBASE_STORAGE_BUCKET="diablo-design-ai.firebasestorage.app"

# Recommended for Google AI Studio / hosted environments that do not expose
# Application Default Credentials with Firestore IAM permissions.
# Store the COMPLETE service-account JSON as ONE private secret value.
# Never commit the real JSON to GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative for local development only:
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
