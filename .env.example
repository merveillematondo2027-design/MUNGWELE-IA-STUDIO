# GEMINI_API_KEY: Required for Gemini AI API calls and prompt enhancement.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional key for OpenAI DALL-E & GPT fallback services.
OPENAI_API_KEY=""

# VEO_API_KEY: Optional dedicated key for Google Veo 3 Video API.
VEO_API_KEY=""

# MUSIC_PROVIDER_API_KEY: Optional key for Suno or third-party music provider.
MUSIC_PROVIDER_API_KEY=""
