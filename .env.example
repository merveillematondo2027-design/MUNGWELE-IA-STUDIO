# APP
APP_URL="MY_APP_URL"

# ACTIVE AI PROVIDERS — SERVER ONLY
# Store the real values in Google AI Studio / hosting secrets.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ELEVENLABS MUSIC — SERVER ONLY
ELEVENLABS_API_KEY=
# Backward-compatible alias currently accepted by the server.
MUSIC_PROVIDER_API_KEY=

# SMART VIDEO / CLIPS PROVIDERS — SERVER ONLY
# These are reserved for the multi-provider router. Keep empty until an
# official commercial API account is connected and validated.
RUNWAY_API_KEY=
MINIMAX_API_KEY=
FAL_API_KEY=
KLING_API_KEY=
SEEDANCE_API_KEY=

# MARKET-CASH PAYMENTS — SERVER ONLY
# Required: private Developer API key issued by Market-Cash.
# Never expose this key with a VITE_ prefix.
MARKET_CASH_API_KEY=
# Optional override only. Leave empty to use the official Market-Cash
# API-key payment bridge deployed by the Market-Cash project.
MARKET_CASH_API_URL=
# Optional: protects the renewal endpoint when an external scheduler is used.
# Keep this value private. The application also runs an idempotent billing
# worker while the server is online.
MUNGWELE_BILLING_CRON_SECRET=

# FIREBASE WEB SDK — PUBLIC CLIENT CONFIG
VITE_FIREBASE_API_KEY="AIzaSyCqY3gtNKX62oFAwdSibtihDA1ifj8SxXs"
VITE_FIREBASE_AUTH_DOMAIN="diablo-design-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="diablo-design-ai"
VITE_FIREBASE_STORAGE_BUCKET="diablo-design-ai.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="582509216306"
VITE_FIREBASE_APP_ID="1:582509216306:web:61337d7a38ff9aa4abf22b"
VITE_FIREBASE_MEASUREMENT_ID="G-77CWBPF23Q"

# FIREBASE ADMIN — SERVER ONLY
FIREBASE_PROJECT_ID="diablo-design-ai"
FIREBASE_STORAGE_BUCKET="diablo-design-ai.firebasestorage.app"

# Recommended for Google AI Studio / hosted environments that do not expose
