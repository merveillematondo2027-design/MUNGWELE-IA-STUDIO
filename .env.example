# ============================================================
# MUNGWELE IA STUDIO — CONFIGURATION TEMPLATE
# Never commit real secret values to GitHub.
# ============================================================

# PUBLIC FRONTEND BUILD CONFIG — NOT A SECRET
# Set this to the direct Cloud Run URL when building the Firebase Hosting UI.
# Example: https://mungwele-ia-api-xxxxx-ew.a.run.app
VITE_GENERATION_API_BASE_URL=

# SERVER RUNTIME
# Comma-separated frontend origins. Use * during initial migration only, then
# restrict this to the official Firebase Hosting/custom-domain origins.
CORS_ALLOWED_ORIGINS=*

# AI PROVIDERS — PRIVATE SERVER SECRETS
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=

# MARKET-CASH
MARKET_CASH_API_KEY=

# ============================================================
# RDC MOBILE MONEY — PRODUCTION
# The interface activates a rail automatically when its required server
# configuration is present. Keep all values private in Secret Manager.
# ============================================================

# M-Pesa RDC
MPESA_API_KEY=
MPESA_SERVICE_PROVIDER_CODE=
# Optional only when supplied/required by Vodacom:
MPESA_ORIGIN=
MPESA_PUBLIC_KEY=

# Airtel Money RDC
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_URL=
AIRTEL_MONEY_MERCHANT_ID=

# Orange Money RDC
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_URL=
ORANGE_MONEY_MERCHANT_ID=

# Afrimoney / Africell RDC
AFRIMONEY_API_KEY=
AFRIMONEY_API_URL=
AFRIMONEY_MERCHANT_ID=

# ============================================================
# EXTERNAL CARD / WALLET GATEWAY
# Used for Visa, Mastercard and other externally processed cards when a
# production gateway is connected. Market-Cash local cards use their own API.
# ============================================================
CARD_PAYMENT_API_KEY=
CARD_PAYMENT_API_URL=
CARD_PAYMENT_MERCHANT_ID=
PAYPAL_API_KEY=
PAYPAL_API_URL=

# FIREBASE ADMIN
# Cloud Run in the same Google Cloud project should normally use Application
# Default Credentials. Keep this empty unless an external runtime requires it.
FIREBASE_SERVICE_ACCOUNT_JSON=
